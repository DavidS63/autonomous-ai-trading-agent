# Alpaca Paper Trading Credentials (required)
# Get free paper keys at: https://app.alpaca.markets (Paper Trading dashboard)
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here

# Finnhub (strongly recommended – free tier at https://finnhub.io)
# Provides company news, earnings calendar, basic fundamentals
FINNHUB_API_KEY=your_finnhub_key_here

# LLM Decision Head (optional but powerful)
# Works with OpenAI, xAI Grok, OpenRouter, Together, local OpenAI-compatible servers, etc.
OPENAI_API_KEY=your_llm_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
# For Grok / xAI: https://api.x.ai/v1
# For OpenRouter: https://openrouter.ai/api/v1
LLM_MODEL=gpt-4o-mini
# Examples: grok-4, claude-3-5-sonnet, gpt-4o, etc.
